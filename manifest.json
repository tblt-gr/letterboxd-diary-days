{
  "manifest_version": 3,
  "name": "Letterboxd Diary Days",
  "version": "1.0.0",
  "description": "Show this year's Letterboxd diary count beside the current day of the year.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Letterboxd Diary Days",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "letterboxd-diary-days@tblt-gr",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/*",
        "https://www.letterboxd.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
